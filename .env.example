# Replace both values with long, random secrets. Never commit a real .env file.
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
ADMIN_BOOTSTRAP_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
COOKIE_SECURE=true

# Optional TURN relay settings for tougher mobile/Wi-Fi NAT combinations.
# Leave TURN_URLS empty to use STUN-only peer connections.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_REALM=eo-cn.example
TURN_EXTERNAL_IP=

# Usage entitlement codes are verified on the server only. Never expose them in frontend JavaScript.
# USER_ACCESS_CODE_HASH is the SHA-256 digest of the user code ALMANTHOMH1234567890.
USER_ACCESS_CODE_HASH=32d0812d9741f3542b0f2eba898868d8bff97877f9db2994a0a1f4073f9e62a9
# Generate a separate one-time code with: python scripts/generate-developer-access-code.py
# It grants 24h/day usage quota only, not admin role. Use --rotate to replace it.
DEVELOPER_ACCESS_CODE_HASH=
# Required in production: persistent encryption key for per-account TOTP secrets.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key private and back it up securely; changing it invalidates enrolled authenticators.
TOTP_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# Separate emergency-room secret hash. Generate using scripts/generate-emergency-vault-code.py.
# Never reuse a code that has been posted in chat or committed to source.
EMERGENCY_VAULT_CODE_HASH=

# EO VAULT production decryption key (32 random bytes, URL-safe Base64).
# Generate with: python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# It must match the private key file used when sealing the release. Never commit it.
EO_MASTER_KEY=REPLACE_WITH_32_BYTE_RANDOM_BASE64_MASTER_KEY
